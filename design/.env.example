# DriveMe — required environment variables
#
# Local: copy to `.env.local` and fill in, then run `vercel dev`.
# Production: set both in the Vercel dashboard under
#   Project → Settings → Environment Variables
# for the Production, Preview and Development environments.
#
# Both are read server-side only, inside /api. Neither is ever sent to the browser:
# the page talks to /api/bookings and /api/notify, and those talk to Supabase.

# Supabase project URL — Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — Project Settings → API → Project API keys → anon public
#
# The anon key is correct here, NOT the service_role key. Row Level Security
# (supabase/migrations/0001_init.sql) is what limits these endpoints to INSERT-only;
# the service_role key bypasses RLS entirely and must never reach this project.
SUPABASE_ANON_KEY=your-anon-public-key
