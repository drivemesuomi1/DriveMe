# DriveMe — required environment variables
#
# Local: copy to `.env.local` and fill in, then run `vercel dev`.
# Production: set both in the Vercel dashboard under
#   Project → Settings → Environment Variables
# for the Production, Preview and Development environments.
#
# Both are read server-side inside /api. The one exception: /api/config hands
# them to the /admin dashboard — both are PUBLIC values by design (RLS and the
# admins table are the security boundary, not key secrecy).

# ⚠ This file is COMMITTED to git. Placeholders only — put real values in
#   .env.local, which is gitignored.

# Supabase project URL — Project Settings → API, or the "Get Connected" panel
SUPABASE_URL=https://your-project-ref.supabase.co

# The project's PUBLIC key. Supabase renamed these in 2025, so it shows up under
# one of two names depending on when the project was created:
#
#   newer projects → "Publishable key",  sb_publishable_...   ← most likely yours
#   older projects → "anon" "public",    eyJ... (a JWT)
#
# Either works, and both go in this one variable.
#
# Do NOT use the secret key ("Secret key" / sb_secret_..., formerly service_role).
# Row Level Security (supabase/migrations/0001_init.sql) is what limits these
# endpoints to INSERT-only; the secret key bypasses RLS entirely.
SUPABASE_ANON_KEY=sb_publishable_your_publishable_key


# ---------------------------------------------------------------------------
# Email — booking alerts to the ops inbox, sent through Resend.
#
# Leave RESEND_API_KEY unset and nothing breaks: the booking still saves and
# the API still returns 201; the alert is skipped and logged. Set it once the
# sending domain is verified in Resend.
# ---------------------------------------------------------------------------

# Resend → API Keys. Prefer a key restricted to "Sending access" over a
# full-access one — this key only ever needs to send.
RESEND_API_KEY=re_your_api_key

# Must be on a domain verified in Resend, or the API refuses the send.
# Customers see this address and reply to it, so use one that receives —
# info@driveme.fi forwards to OPS_EMAIL via ImprovMX.
MAIL_FROM=DriveMe <info@driveme.fi>

# Where new-booking alerts land. info@driveme.fi needs an actual inbox behind
# it (an MX record — a forwarder like ImprovMX is enough); until that exists,
# point this at an address you can already read.
OPS_EMAIL=info@driveme.fi

# Origin used for links inside emails (the "Open in admin" button).
# Netlify supplies URL automatically, so this is only needed to override it.
PUBLIC_BASE_URL=https://driveme.fi
